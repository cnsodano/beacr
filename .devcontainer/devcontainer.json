{
    // Mainly copied from: https://github.com/eddelbuettel/r2u/blob/master/.devcontainer/devcontainer.json 
    "name": "R Package Dev",
    "build": {
        "dockerfile": "Dockerfile"
        // "context": ".."
    },
    "features": {
        "ghcr.io/rocker-org/devcontainer-features/r-rig:1": {
            // See: https://github.com/rocker-org/devcontainer-features/blob/main/src/r-apt/README.md#options
            //
            "version": "4.5.2"
            // Use RSupport (incl languageserver and httpgd) spand bspm
            // "vscodeRSupport": "full",
            // "installBspm": true,  // leftover from using the r-apt feature
            //
            // You can add each of these individually or jointly. See the table at
            // https://github.com/rocker-org/devcontainer-features/blob/main/src/r-apt/README.md#options
            // "installRadian": true,
            // "installREnv": true,
            // I am going to handle installing all R packages after the build to be able to pin the versions via renv, so I disable these 
            // "installDevTools": false,
            // "installRMarkdown": false,
            // "installVscDebugger": false,
            // "pandocVersion": "3.7.0.2",
            // "useTesting": false
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "REditorSupport.r",
                "RDebugger.r-debugger",
                "posit.air-vscode"
            ],
            "settings": {
                "r.rterm.linux": "/usr/local/bin/R",
                // turn these two on with Radian
                // "r.rterm.linux": "/usr/local/bin/radian",
                "r.bracketedPaste": true,
                "r.plot.useHttpgd": true,
                "[r]": {
                    "editor.tabSize": 2, // Indent with two spaces, but only for R
                    "editor.insertSpaces": true,
                    "editor.formatOnSave": true
                },
                "r.lsp.diagnostics": true
            }
        },
        // "postCreateCommand": "R -e 'if (file.exists(\"renv.lock\")) renv::restore() else devtools::install_deps(dependencies = TRUE)'",
        "remoteUser": "root"
    }
}